# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Diké engine (https://github.com/Grizaceo/dike). Set ONE of:
# Docker image built with `docker build -t dike .` in the dike repo (runs with --network none)
# DIKE_DOCKER_IMAGE=dike
# Or a locally installed engine (Linux, Python 3.11+)
# DIKE_BIN=dike
# Optional, local engine only: Ed25519 content key (mode 0600) used to sign commitments
# LEXO_CONTENT_SIGNING_KEY_PATH=
